{{#> layout title="Verify your email"}}
<p>Hi {{name}},</p>
<p>Confirm your email address to finish setting up your {{appName}} account.</p>
<a class="cta" href="{{url}}">Verify email</a>
<p class="muted">If the button does not work, paste this link into your browser: {{url}}</p>
<p>If you did not create an account, you can ignore this email.</p>
{{/layout}}
