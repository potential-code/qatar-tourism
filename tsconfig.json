{
  // One config for the whole repository: client, shared and e2e are type-checked as one
  // program.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["bun"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // Lets vite.config.ts import .ts with an explicit extension, as Vite's native config loader requires.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,

    // No baseUrl: removed in TypeScript 7. Every path is relative to this file.
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["client", "shared", "e2e", "playwright.config.ts"],
  "exclude": ["node_modules", "**/dist"]
}
