# Copy to .env and fill in. Never commit .env. An empty value counts as unset.

# --- Server ---------------------------------------------------------------
# NODE_ENV is deliberately absent. The server defaults to development, compose sets it when
# deployed, and the client build shares this file: a NODE_ENV here makes Vite bundle React's
# development build.
PORT=8000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# --- Auth (Better Auth) ---------------------------------------------------
# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this API (auth links in emails point here)
BETTER_AUTH_URL=http://localhost:8000
# Browser origins allowed to call the API with cookies, comma-separated, exact match
CLIENT_URL=http://localhost:5173

# --- Reverse proxy --------------------------------------------------------
# Set to true ONLY when the API is reachable solely through your own proxy
# (Traefik under Dokploy in production). Then the client IP for rate limiting
# is the right-most X-Forwarded-For entry; otherwise the header is ignored.
TRUST_PROXY=false

# --- Email: production (Amazon SES) -----------------------------------------
AWS_REGION=us-east-1
# Leave both empty to use the AWS default credential chain (e.g. an IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=no-reply@example.com

# --- Email: development (Mailpit) -------------------------------------------
# SMTP on 1025, web UI on http://localhost:8025
MAILPIT_HOST=localhost
MAILPIT_PORT=1025

# --- Seed (bun run db:seed, development only) -------------------------------
# Passwords: at least 12 characters. Not read by the server.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=

# --- Client (build args) ----------------------------------------------------
VITE_API_URL=http://localhost:8000
