# Copy to .env if you want to change a default. Never commit .env. Every value is optional.
# There is no backend: these only affect the Vite dev server and the static build.

# Port for `bun run dev` (default 5173).
CLIENT_PORT=5173

# Reference date (YYYY-MM-DD) for every "Day +N" offset in the seeded demo data.
# Unset keeps the fixed reference date in shared/constants/demo.ts.
VITE_DEMO_REFERENCE_DATE=

# HTTP Basic Auth for the Vite dev/preview server and docker compose. Unset: admin / Potential.
# The browser asks once per session; every page and dashboard reuses it.
# BASIC_AUTH=off serves it openly (local runs only). A bare `docker run` with neither
# user nor pass set answers 503, so the image is never served unprotected.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
BASIC_AUTH=
