# Copy to .env if you want to change a default. Never commit .env. Every value is optional.
# There is no backend: these only affect the Vite dev server and the static build.

# Port for `bun run dev` (default 5173).
CLIENT_PORT=5173

# Reference date (YYYY-MM-DD) for every "Day +N" offset in the seeded demo data.
# Unset keeps the fixed reference date in shared/constants/demo.ts.
VITE_DEMO_REFERENCE_DATE=

# HTTP Basic Auth for the Docker image (nginx). Both set: the site asks for them.
# Either unset: the site answers 503, so it is never served unprotected.
# BASIC_AUTH=off serves it openly (local runs only).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
BASIC_AUTH=
