{
  "name": "qatar-tourism",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "cd client && bunx --bun vite --host 0.0.0.0",
    "build": "bun run typecheck && bun run build:client",
    "build:client": "cd client && NODE_ENV=production bunx --bun vite build",
    "preview": "cd client && bunx --bun vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./client/test/setup.ts ./client ./shared",
    "test:e2e": "playwright test",
    "scorm:build": "bun scorm/qta-sample-c04/build.ts",
    "content:build": "bun scorm/content-library/build.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
